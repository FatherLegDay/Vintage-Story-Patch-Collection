[
    // Create unlocked copies of all drifter models
    {
        "file": "rpdrifters:config/customplayermodels/rpdriftersurface.json",
        "op": "copy",
        "fromPath": "/rpdriftersurface",
        "path": "/rpdriftersurface-unlocked",
        "dependsOn": [ { "modId": "rpdrifters" } ]
    },
    {
        "file": "rpdrifters:config/customplayermodels/rpdrifterdeep.json",
        "op": "copy",
        "fromPath": "/rpdrifterdeep",
        "path": "/rpdrifterdeep-unlocked",
        "dependsOn": [ { "modId": "rpdrifters" } ]
    },
    {
        "file": "rpdrifters:config/customplayermodels/rpdriftertainted.json",
        "op": "copy",
        "fromPath": "/rpdriftertainted",
        "path": "/rpdriftertainted-unlocked",
        "dependsOn": [ { "modId": "rpdrifters" } ]
    },
    {
        "file": "rpdrifters:config/customplayermodels/rpdriftercorrupt.json",
        "op": "copy",
        "fromPath": "/rpdriftercorrupt",
        "path": "/rpdriftercorrupt-unlocked",
        "dependsOn": [ { "modId": "rpdrifters" } ]
    },
    {
        "file": "rpdrifters:config/customplayermodels/rpdrifternightmare.json",
        "op": "copy",
        "fromPath": "/rpdrifternightmare",
        "path": "/rpdrifternightmare-unlocked",
        "dependsOn": [ { "modId": "rpdrifters" } ]
    },
    
    // Limit locked models to 90%-110% height
    {
        "file": "@@rpdrifters:config/customplayermodels/rpdrifter[a-z]+\.json",
        "op": "replace",
        "path": "/@@@[^-]+/SizeRange",
        "value": [ 0.9, 1.1 ],
        "dependsOn": [ { "modId": "rpdrifters" } ]
    },
    {
        "file": "@@rpdrifters:config/customplayermodels/rpdrifter[a-z]+\.json",
        "op": "replace",
        "path": "/@@@[^-]+/MaxCollisionBox",
        "value": [ 0.55, 1.39 ],
        "dependsOn": [ { "modId": "rpdrifters" } ]
    },
    {
        "file": "@@rpdrifters:config/customplayermodels/rpdrifter[a-z]+\.json",
        "op": "replace",
        "path": "/@@@[^-]+/MaxEyeHeight",
        "value": 1.39,
        "dependsOn": [ { "modId": "rpdrifters" } ]
    },
    
    // Limit unlocked models to 14%-3000% height
    {
        "file": "@@rpdrifters:config/customplayermodels/rpdrifter[a-z]+\.json",
        "op": "replace",
        "path": "/@@*-unlocked/SizeRange",
        "value": [ 0.14, 10 ],
        "dependsOn": [ { "modId": "rpdrifters" } ]
    },
    {
        "file": "@@rpdrifters:config/customplayermodels/rpdrifter[a-z]+\.json",
        "op": "replace",
        "path": "/@@*-unlocked/MaxCollisionBox",
        "value": [ 5, 12.667 ],
        "dependsOn": [ { "modId": "rpdrifters" } ]
    },
    {
        "file": "@@rpdrifters:config/customplayermodels/rpdrifter[a-z]+\.json",
        "op": "replace",
        "path": "/@@*-unlocked/MinCollisionBox",
        "value": [ 0.086, 0.187 ],
        "dependsOn": [ { "modId": "rpdrifters" } ]
    },
    {
        "file": "@@rpdrifters:config/customplayermodels/rpdrifter[a-z]+\.json",
        "op": "replace",
        "path": "/@@*-unlocked/MaxEyeHeight",
        "value": 12.667,
        "dependsOn": [ { "modId": "rpdrifters" } ]
    },
    {
        "file": "@@rpdrifters:config/customplayermodels/rpdrifter[a-z]+\.json",
        "op": "replace",
        "path": "/@@*-unlocked/MinEyeHeight",
        "value": 0.187,
        "dependsOn": [ { "modId": "rpdrifters" } ]
    }
]