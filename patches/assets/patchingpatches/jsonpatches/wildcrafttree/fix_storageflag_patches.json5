[
    // Add clothes (256) storage flag bit to stick. Why? No idea. Just copying from 1.3.4. (33 + 256 = 289)
    {
        "file": "wildcrafttree:patches/storagetypes.json",
        "op": "replace",
        "path": "/file=game:itemtypes//resource//stick/value",
        "value": 289,
        "dependsOn": [{ "modId": "wildcrafttree" }]
    },

    // Replace fish with fishraw
    {
        "file": "wildcrafttree:patches/storagetypes.json",
        "op": "replace",
        "path": "/file=game:itemtypes//food//fish/file",
        "value": "game:itemtypes/food/fishraw",
        "dependsOn": [{ "modId": "wildcrafttree" }]
    },

    // Add fishfillet
    {
        "file": "game:itemtypes/food/fishfillet",
        "op": "add",
        "path": "/storageFlags",
        "value": 33, 
        "side": "server",
        "dependsOn": [{ "modId": "wildcrafttree" }]
    },

    // Fix file location for seashell
    {
        "file": "wildcrafttree:patches/storagetypes.json",
        "op": "replace",
        "path": "/file=game:blocktypes//bone//seashell/file",
        "value": "game:blocktypes/aquatic/seashell",
        "dependsOn": [{ "modId": "wildcrafttree" }]
    },

    // Add additional patches from 1.3.4
    {
        "file": "game:itemtypes/resource/fat-rendered",
        "op": "add",
        "path": "/storageFlags",
        "value": 33,
        "side": "server",
        "dependsOn": [{ "modId": "wildcrafttree" }]
    },
    {
        "file": "game:itemtypes/resource/hide-species",
        "op": "add",
        "path": "/storageFlags",
        "value": 33,
        "side": "server",
        "dependsOn": [{ "modId": "wildcrafttree" }]
    },
    {
        "file": "game:itemtypes/resource/hide-species-headed",
        "op": "add",
        "path": "/storageFlags",
        "value": 33,
        "side": "server",
        "dependsOn": [{ "modId": "wildcrafttree" }]
    }
]