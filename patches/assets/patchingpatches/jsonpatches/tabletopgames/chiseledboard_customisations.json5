[
    // By default, custom gameboards must be supported from below or they'll drop as an item. This removes that behaviour.
    {
        "file": "tabletopgames:blocktypes/board/chiseledboard.json",
        "op": "remove",
        "path": "/behaviors/name=Unstable",
        "dependsOn": [{ "modId": "tabletopgames" }]
    },

    // Resizes the size of custom pieeces so that at 1.0 scale they occupy exactly 1/16 of a block.
    {
        "file": "tabletopgames:itemtypes/piece/chiseledpiece.json",
        "op": "replace",
        "path": "/attributes/onChiseledBoardTransform/scale",
        "value": 0.1875,
        "dependsOn": [{ "modId": "tabletopgames" }]
    }
]