[
	{
		//Fixes Tier 4 Refractory brick textures from Improved metallurgy when used with bricklayers
		"file": "game:itemtypes/resource/refractorybrick.json",
		"op": "replace",
		"path": "/texturesByType",
		"value": {
			"*-raw-tier4": {
				"0": {
					"base": "improved_metallurgy:block/clay/refractory/tier4/raw-side"
				}
			},
			"*-fired-tier4": {
                "0": {
					"base": "improved_metallurgy:block/clay/refractory/tier4/side"
				}
			},
			"*-raw-*": {
				"material": {
					"base": "block/clay/refractory/{type}/{state}-side"
				},
				"top": {
					"base": "block/clay/refractory/{type}/{state}-top"
				}
			},
			"*-fired-*": {
				"material": {
					"base": "block/clay/refractory/{type}/side"
				},
				"top": {
					"base": "block/clay/refractory/{type}/top"
				}
			}
		},
		"dependsOn": [
			{
				"modId": "improvedmetallurgy"
			},
			{
				"modId": "bricklayers"
			}
		]
	}
]
